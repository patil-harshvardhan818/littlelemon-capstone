# Copy this file to ".env" (same folder as manage.py) and replace the values.
# The real ".env" file is listed in .gitignore and must NEVER be committed.

# --- Django ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
# Optional (comma separated). Defaults to localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ---
DB_NAME=littlelemon
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: set to True to run "python manage.py test" on an in-memory SQLite
# database instead of MySQL (useful if your MySQL user cannot create databases).
USE_SQLITE_FOR_TESTS=False
